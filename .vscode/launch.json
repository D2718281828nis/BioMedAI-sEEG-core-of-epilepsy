{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Analyse all EDF files",
      "type": "debugpy",
      "request": "launch",
      "module": "extreme_event_agent.cli",
      "args": [
        "${workspaceFolder}/dataset",
        "--output", "${workspaceFolder}/seeg_agent_output"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Analyse EDF by clinical clock",
      "type": "debugpy",
      "request": "launch",
      "module": "extreme_event_agent.cli",
      "args": [
        "${input:edfFile}",
        "--output", "${workspaceFolder}/seeg_agent_output",
        "--event-clock", "${input:eventClock}",
        "--event-label", "асимметричный тонический приступ"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "DICOM viewer (MRI with electrodes)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/dicom_viewer/viewer.py",
      "args": [
        "${workspaceFolder}/dataset/MRI-with-electrodes/DCM",
        "--series", "${input:dicomSeries}"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "DICOM viewer: list series",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/dicom_viewer/viewer.py",
      "args": [
        "${workspaceFolder}/dataset/MRI-with-electrodes/DCM",
        "--list-series"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Reservoir plant (model/)",
      "type": "debugpy",
      "request": "launch",
      "module": "model.run_model",
      "args": [
        "${input:edfFile}",
        "--output", "${workspaceFolder}/model_result",
        "--channel-selection", "${input:channelSelection}"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Structural anomaly (multimodal_approach/)",
      "type": "debugpy",
      "request": "launch",
      "module": "multimodal_approach.run_multimodal",
      "args": [
        "--dicom-dir", "${workspaceFolder}/dataset/MRI-with-electrodes/DCM",
        "--agent-output", "${workspaceFolder}/seeg_agent_output/sEEG-HFOs-8",
        "--output", "${workspaceFolder}/multimodal_result"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Object model: EDF + DICOM + reservoir",
      "type": "debugpy",
      "request": "launch",
      "module": "object_model.run_object_model",
      "args": [
        "--edf", "${input:edfFile}",
        "--dicom-dir", "${workspaceFolder}/dataset/MRI-with-electrodes/DCM",
        "--crop-end-seconds", "10550",
        "--channel-selection", "${input:channelSelection}",
        "--output", "${workspaceFolder}/object_model_result"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "GNN (gnn_model/): baseline -- unregularized, overfits on purpose",
      "type": "debugpy",
      "request": "launch",
      "module": "gnn_model.run_gnn",
      "args": [
        "--graph", "${input:gnnGraphFile}",
        "--output", "${workspaceFolder}/gnn_model_result/baseline_overfit",
        "--epochs", "${input:gnnEpochs}"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "GNN (gnn_model/): regularized -- DropEdge + early stopping",
      "type": "debugpy",
      "request": "launch",
      "module": "gnn_model.run_gnn",
      "args": [
        "--graph", "${input:gnnGraphFile}",
        "--output", "${workspaceFolder}/gnn_model_result/regularized",
        "--epochs", "300",
        "--hidden-channels", "8",
        "--dropout", "0.6",
        "--weight-decay", "1e-2",
        "--drop-edge-p", "0.3",
        "--early-stopping-patience", "20"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "GNN (gnn_model/): attention -- single-head GATv2 + DropEdge + val_macro_f1 early stopping",
      "type": "debugpy",
      "request": "launch",
      "module": "gnn_model.run_gnn",
      "args": [
        "--graph", "${input:gnnGraphFile}",
        "--output", "${workspaceFolder}/gnn_model_result/attention",
        "--architecture", "gat",
        "--heads", "1",
        "--num-layers", "1",
        "--dropout", "0.5",
        "--drop-edge-p", "0.2",
        "--early-stopping-patience", "40",
        "--early-stopping-metric", "val_macro_f1",
        "--epochs", "300"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "GNN (gnn_model/): attention deep -- 3-layer residual GATv2 + DropEdge + val_macro_f1",
      "type": "debugpy",
      "request": "launch",
      "module": "gnn_model.run_gnn",
      "args": [
        "--graph", "${input:gnnGraphFile}",
        "--output", "${workspaceFolder}/gnn_model_result/attention_deep",
        "--architecture", "gat",
        "--heads", "2",
        "--num-layers", "3",
        "--hidden-channels", "8",
        "--residual",
        "--dropout", "0.4",
        "--drop-edge-p", "0.2",
        "--weight-decay", "0.2",
        "--early-stopping-patience", "60",
        "--early-stopping-metric", "val_macro_f1",
        "--epochs", "300"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "GNN (gnn_model/): attention deep, 5-fold cross-validated",
      "type": "debugpy",
      "request": "launch",
      "module": "gnn_model.run_gnn",
      "args": [
        "--graph", "${input:gnnGraphFile}",
        "--output", "${workspaceFolder}/gnn_model_result/attention_deep_cv",
        "--architecture", "gat",
        "--heads", "2",
        "--num-layers", "3",
        "--hidden-channels", "8",
        "--residual",
        "--dropout", "0.4",
        "--drop-edge-p", "0.2",
        "--weight-decay", "0.2",
        "--early-stopping-patience", "60",
        "--early-stopping-metric", "val_macro_f1",
        "--epochs", "300",
        "--cross-validate", "5"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "GNN (gnn_model/): attention deep, 5-fold cross-validated, SHAFT-GROUPED",
      "type": "debugpy",
      "request": "launch",
      "module": "gnn_model.run_gnn",
      "args": [
        "--graph", "${input:gnnGraphFile}",
        "--output", "${workspaceFolder}/gnn_model_result/attention_deep_cv_shaft",
        "--architecture", "gat",
        "--heads", "2",
        "--num-layers", "3",
        "--hidden-channels", "8",
        "--residual",
        "--dropout", "0.4",
        "--drop-edge-p", "0.2",
        "--weight-decay", "0.2",
        "--early-stopping-patience", "60",
        "--early-stopping-metric", "val_macro_f1",
        "--epochs", "300",
        "--cross-validate", "5",
        "--group-by-shaft"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "DFA: augment graph with per-channel DFA exponent (gnn_model/)",
      "type": "debugpy",
      "request": "launch",
      "module": "gnn_model.augment_dfa",
      "args": [
        "--edf", "${input:edfFile}",
        "--graph", "${workspaceFolder}/object_model_result/sEEG-HFOs-8/object_model_graph.graphml",
        "--output", "${workspaceFolder}/object_model_result/sEEG-HFOs-8/object_model_graph_dfa.graphml",
        "--baseline-seconds", "30"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "GNN (gnn_model/): attention deep + DFA, 5-fold cross-validated",
      "type": "debugpy",
      "request": "launch",
      "module": "gnn_model.run_gnn",
      "args": [
        "--graph", "${workspaceFolder}/object_model_result/sEEG-HFOs-8/object_model_graph_dfa.graphml",
        "--output", "${workspaceFolder}/gnn_model_result/attention_deep_dfa_cv",
        "--architecture", "gat",
        "--heads", "2",
        "--num-layers", "3",
        "--hidden-channels", "8",
        "--residual",
        "--dropout", "0.4",
        "--drop-edge-p", "0.2",
        "--weight-decay", "0.2",
        "--early-stopping-patience", "60",
        "--early-stopping-metric", "val_macro_f1",
        "--epochs", "300",
        "--cross-validate", "5"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "GNN (gnn_model/): attention deep + DFA, 5-fold cross-validated, SHAFT-GROUPED",
      "type": "debugpy",
      "request": "launch",
      "module": "gnn_model.run_gnn",
      "args": [
        "--graph", "${workspaceFolder}/object_model_result/sEEG-HFOs-8/object_model_graph_dfa.graphml",
        "--output", "${workspaceFolder}/gnn_model_result/attention_deep_dfa_cv_shaft",
        "--architecture", "gat",
        "--heads", "2",
        "--num-layers", "3",
        "--hidden-channels", "8",
        "--residual",
        "--dropout", "0.4",
        "--drop-edge-p", "0.2",
        "--weight-decay", "0.2",
        "--early-stopping-patience", "60",
        "--early-stopping-metric", "val_macro_f1",
        "--epochs", "300",
        "--cross-validate", "5",
        "--group-by-shaft"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "edfFile",
      "type": "promptString",
      "description": "Absolute path to the EDF file",
      "default": "${workspaceFolder}/dataset/sEEG-HFOs-8.edf"
    },
    {
      "id": "eventClock",
      "type": "promptString",
      "description": "Expert wall-clock time HH:MM:SS, only if independently confirmed synchronized to this EDF's own meas_date header. For sEEG-HFOs-8.edf it is not (offsets computed from it fall outside the recording) — use \"Analyse all EDF files\" instead, which reads the seizure time from the EDF's own embedded annotation.",
      "default": ""
    },
    {
      "id": "dicomSeries",
      "type": "promptString",
      "description": "Series number to load (run \"DICOM viewer: list series\" first to see choices). Series 5 = t1_mprage_tra_p2_iso, series 6 = t2_space_TR_p2_iso.",
      "default": "5"
    },
    {
      "id": "channelSelection",
      "type": "pickString",
      "description": "Reservoir output-channel strategy (model/plant.py). 'recruitment' reuses analyse_brain_process's own likely_initiators — NOT independent of it, so its lateralization cannot cross-check that analysis. 'balanced' splits channels evenly by hemisphere, ranked by pre-event-only variance — the only mode where ReservoirWindow.arbitration_valid is True.",
      "options": ["balanced", "recruitment"],
      "default": "balanced"
    },
    {
      "id": "gnnGraphFile",
      "type": "promptString",
      "description": "GraphML file to train the GNN on (written by \"Object model: EDF + DICOM + reservoir\", or extreme_event_agent.edf_workflow.build_seizure_graph directly)",
      "default": "${workspaceFolder}/object_model_result/sEEG-HFOs-8/object_model_graph.graphml"
    },
    {
      "id": "gnnEpochs",
      "type": "promptString",
      "description": "Number of training epochs for the GNN",
      "default": "200"
    }
  ]
}
